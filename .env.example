# Copy this file to .env and replace every placeholder before deployment.
# Never commit the real .env file.
APPOINTMENT_API_KEY=replace-with-a-random-64-character-secret
UI_SETUP_TOKEN=replace-with-a-separate-random-secret
SESSION_SECRET=replace-with-another-separate-random-secret
# HospitalAgent's patients registry, read as hospital_reader (development default shown).
# compose.yaml uses this same default when the variable is unset or empty, so the check stays
# on under docker compose; it is off only when the app runs without compose and
# PATIENT_REGISTRY_URL is unset or empty.
PATIENT_REGISTRY_URL=postgresql+psycopg://hospital_reader:hospital_reader_dev@host.docker.internal:54322/hospital
# With HospitalAgent's database on AWS RDS, point it there instead (the password is the
# READER_DB_PASSWORD in HospitalAgent's .env, URL-encoded):
# PATIENT_REGISTRY_URL=postgresql+psycopg://hospital_reader:<password>@<your-rds-endpoint>:5432/hospital?sslmode=require
